---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import PageHead from '../components/PageHead.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { writingCategories, writingCategoryOrder } from '../data/site';

const description =
  'Essays by Juan Mackie on AI and operations, business, building products, investing, systems, and long horizons. The archive spans different periods and interests.';

const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const grouped = writingCategoryOrder
  .map((category) => ({
    category,
    label: writingCategories[category],
    items: entries.filter((entry) => entry.data.category === category)
  }))
  .filter((group) => group.items.length > 0);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC'
  }).format(date);
---

<BaseLayout title="Writing — Juan Mackie" description={description} crumbs={[{ name: 'Writing' }]}>
  <Fragment slot="nav"><Nav /></Fragment>
  <Fragment slot="head"><link rel="alternate" type="application/rss+xml" title="Juan Mackie — Writing" href="/writing/rss.xml" /></Fragment>

  <section class="shell--wide page-block">
    <PageHead
      eyebrow="Writing"
      title="Notes that survived the draft."
      lede="Essays on AI, business, money, tools, and the systems around them. These notes span different periods and interests. Older pieces are kept as written; they are part of the record, not all current positions."
    >
      <div class="button-row">
        <a class="button button--solid" href="/writing/rss.xml">
          RSS feed
          <span class="button__icon" aria-hidden="true">↗</span>
        </a>
        <a class="button" href="#essays">
          Browse archive
          <span class="button__icon" aria-hidden="true">↓</span>
        </a>
      </div>
    </PageHead>
  </section>

  <section class="shell--wide bento" id="essays" aria-labelledby="essays-heading">
    <div class="section-heading" style="grid-column: 1 / -1;">
      <p class="eyebrow">Index // {entries.length.toString().padStart(2, '0')} published</p>
      <h2 id="essays-heading">All essays, grouped.</h2>
    </div>

    {grouped.map((group) => (
      <article class="double-bezel bento__span-12 card reveal" id={group.category}>
        <div class="double-bezel__core">
          <div class="card__topline">
            <span class="card__kicker">{group.label}</span>
            <span class="card__index">{group.items.length.toString().padStart(2, '0')}</span>
          </div>
          <ol class="numbered-list">
            {group.items.map((item: CollectionEntry<'writing'>, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <a href={`/writing/${item.id}`}>{item.data.title}</a>
                  <p class="card__description">{formatDate(item.data.date)}{item.data.description ? ` · ${item.data.description}` : ''}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
