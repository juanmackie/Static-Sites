---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { promptPaulPrivacy } from '../data/site';

const description = 'Privacy information for the Juan Mackie site and Prompt Paul, including analytics, chat, and public configuration.';
---

<BaseLayout title="Privacy — Juan Mackie" description={description} crumbs={[{ name: 'Privacy' }]}>
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="shell--narrow" style="padding-block: 8rem 5rem;">
    <article class="double-bezel reveal">
      <div class="double-bezel__core prose">
        <p class="eyebrow">Privacy</p>
        <h1>Privacy policy</h1>
        <p class="muted">Prompt Paul</p>
        {promptPaulPrivacy.map((line, index) => (
          index === 0 ? <p class="muted">{line}</p> : <p>{line}</p>
        ))}
        <p class="muted">Site integrations</p>
        <p>Analytics is disabled unless a public Google Analytics or Umami configuration is supplied at build time. If enabled, the selected provider receives its standard website-usage data.</p>
        <p>When enabled, the Last.fm panel requests public recent-track data for the configured username directly from Last.fm. It does not perform account actions.</p>
        <p>The selected theme is stored locally in your browser. No account is required for the site.</p>
        <p>Messages sent through the optional site chat are sent to the configured automation service. Do not send confidential, safety-sensitive, or personal information through chat; email is the direct contact route.</p>
        <p><a class="text-link" href="/">Back to home</a></p>
      </div>
    </article>
  </section>
</BaseLayout>
