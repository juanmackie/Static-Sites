---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="shell--narrow" style="padding-block: 8rem 5rem;">
    <article class="double-bezel reveal">
      <div class="double-bezel__core prose">
        <p class="eyebrow">404</p>
        <h1>Page not found</h1>
        <p>The page you asked for is not here. Return to the index and continue from there.</p>
        <p><a class="button button--solid" href="/">
          Back home
          <span class="button__icon" aria-hidden="true">↓</span>
        </a></p>
      </div>
    </article>
  </section>
</BaseLayout>
