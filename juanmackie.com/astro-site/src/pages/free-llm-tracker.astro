---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';

const title = 'Free LLM Tracker — Juan Mackie';
const description = 'Daily tracker of free and paid LLM routes across OpenRouter and Vercel AI Gateway, ranked by Artificial Analysis intelligence and cost per synthetic task.';
---

<BaseLayout title={title} description={description} crumbs={[{ name: 'Free LLM Tracker' }]}>
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="shell--wide page-block">
    <div class="section-heading reveal" style="margin-bottom:1.25rem;">
      <p class="eyebrow">LLM / OpenRouter / Vercel AI Gateway / Artificial Analysis</p>
      <h1>Free LLM Tracker</h1>
      <p class="display__lede">A daily top 10 of free and paid routes ranked by intelligence per dollar, plus the full free-route list with Artificial Analysis scores. This page reads the latest dataset committed by GitHub Actions.</p>
    </div>
  </section>

  <section class="shell--wide bento" id="tracker" aria-label="Model tracker">
    <div id="tracker-root" style="display:contents;">
      <p class="muted" role="status">Loading the latest tracker data…</p>
    </div>
  </section>

  <section class="shell--wide page-block reveal" aria-label="Data notes">
    <p class="muted" style="max-width:70ch;line-height:1.65;">
      <strong>Sources:</strong> <a class="text-link" href="https://openrouter.ai/collections/free-models" target="_blank" rel="noreferrer">OpenRouter</a> and <a class="text-link" href="https://vercel.com/docs/ai-gateway" target="_blank" rel="noreferrer">Vercel AI Gateway</a> supply the route lists and per-token pricing; <a class="text-link" href="https://artificialanalysis.ai/leaderboards/models" target="_blank" rel="noreferrer">Artificial Analysis</a> supplies intelligence and speed scores. The GitHub Action runs daily and commits the combined dataset. Unscored models show “—”.
    </p>
    <p class="muted" style="max-width:70ch;line-height:1.65;margin-top:0.6rem;">
      <strong>Method:</strong> cost per task assumes a synthetic request of 4,000 input and 1,000 output tokens priced at each route’s per-token rates. The top 10 splits its slots evenly between free routes (ranked by intelligence) and paid routes (ranked by value index: Artificial Analysis score per 1,000 synthetic tasks). “~” marks gateway prices that vary by backing provider. InferX is not yet aggregated — their catalog has no public pricing endpoint.
    </p>
  </section>

  <script>
    (() => {
      const root = document.getElementById('tracker-root');
      if (!root) return;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      })[char]);

      const plainText = (value) => String(value ?? '')
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/[*_`#>]/g, '')
        .replace(/\s+/g, ' ')
        .trim();

      const contextLabel = (value) => {
        const context = Number(value) || 0;
        if (context >= 1_000_000) return `${(context / 1_000_000).toFixed(1)}M`;
        if (context >= 1_000) return `${Math.round(context / 1_000)}K`;
        return context ? String(context) : '—';
      };

      const scoreColor = (score) => score == null ? 'var(--subtle)' : 'var(--accent)';

      const render = (data) => {
        const allModels = Array.isArray(data.models) ? data.models : [];
        let ascending = false;
        const compareScores = (a, b) => {
          if (a.intelligence == null) return 1;
          if (b.intelligence == null) return -1;
          return ascending ? a.intelligence - b.intelligence : b.intelligence - a.intelligence;
        };
        let models = [...allModels].sort(compareScores);

        const table = (rows) => rows.map((model, index) => `
          <tr style="border-bottom:1px solid var(--line-soft);">
            <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--subtle);">${index + 1}</td>
            <td style="padding:0.7rem 0.85rem;">
              <div style="font-weight:700;color:var(--text);">${escapeHtml(model.name || 'Unknown')}</div>
              <div style="font-size:0.75rem;color:var(--subtle);margin-top:0.15rem;">${escapeHtml(model.provider || '—')}</div>
              <div style="font-size:0.72rem;color:var(--muted);margin-top:0.15rem;">${escapeHtml(plainText(model.description))}</div>
            </td>
            <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-weight:700;color:${scoreColor(model.intelligence)};">${model.intelligence ?? '—'}</td>
            <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--muted);">${contextLabel(model.context)}</td>
            <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--subtle);">${escapeHtml(model.aa_speed || '—')}</td>
          </tr>`).join('');

        const updateTable = (rows) => {
          const body = document.querySelector('[data-tracker-body]');
          const empty = document.querySelector('[data-tracker-empty]');
          if (body) body.innerHTML = table(rows);
          if (body) body.hidden = rows.length === 0;
          if (empty) empty.hidden = rows.length !== 0;
        };

        const scored = allModels.filter((model) => model.intelligence != null);
        const best = [...scored].sort((a, b) => b.intelligence - a.intelligence)[0];
        const generated = data.generated ? new Date(data.generated).toLocaleString('en-AU', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }) + ' UTC' : 'Unknown';

        const sourceLabel = { openrouter: 'OpenRouter', vercel: 'Vercel AI Gateway' };
        const top10 = Array.isArray(data.top10) ? data.top10 : [];
        const top10Html = top10.length === 0 ? '' : `
        <article class="double-bezel bento__span-12 card">
          <div class="double-bezel__core">
            <div class="card__topline" style="margin-bottom:1.25rem;">
              <span class="card__kicker">Top 10 value picks</span>
              <span class="card__index">5 free + 5 paid</span>
            </div>
            <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2.2rem,4.5vw,4.8rem);line-height:0.92;letter-spacing:-0.055em;margin:0 0 0.4rem;">Best models to use</h2>
            <p class="card__description" style="margin-bottom:1.25rem;">Free routes ranked by intelligence, paid routes ranked by value index (Artificial Analysis score per 1,000 synthetic tasks of 4K in / 1K out).</p>
            <div class="table-scroll" tabindex="0" role="region" aria-label="Top 10 value picks table">
              <table>
                <caption class="sr-only">Top 10 free and paid model routes ranked by intelligence and value</caption>
                <thead><tr><th scope="col">#</th><th scope="col">Model</th><th scope="col">Source</th><th scope="col">$/task</th><th scope="col">Score</th><th scope="col">Value /1k tasks</th><th scope="col">Context</th></tr></thead>
                <tbody>${top10.map((row, index) => `
                  <tr style="border-bottom:1px solid var(--line-soft);">
                    <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--subtle);">${index + 1}</td>
                    <td style="padding:0.7rem 0.85rem;">
                      <div style="font-weight:700;color:var(--text);">${escapeHtml(row.name || 'Unknown')}</div>
                      <div style="font-size:0.75rem;color:var(--subtle);margin-top:0.15rem;">${escapeHtml(row.provider || '—')}</div>
                    </td>
                    <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:var(--muted);white-space:nowrap;">${escapeHtml(sourceLabel[row.source] || row.source)}</td>
                    <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-weight:700;color:${row.free ? 'var(--accent-2)' : 'var(--text)'};">${row.free ? 'Free' : `${row.approximate ? '~' : ''}$${row.task_cost >= 0.1 ? row.task_cost.toFixed(2) : row.task_cost.toFixed(4)}`}</td>
                    <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-weight:700;color:${scoreColor(row.intelligence)};">${row.intelligence ?? '—'}</td>
                    <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--muted);">${row.free ? '—' : (row.value ?? '—')}</td>
                    <td style="padding:0.7rem 0.85rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:var(--subtle);">${contextLabel(row.context)}</td>
                  </tr>`).join('')}
                </tbody>
              </table>
            </div>
          </div>
        </article>`;

        root.innerHTML = `${top10Html}
          <article class="double-bezel bento__span-12 card">
          <div class="double-bezel__core">
          <div class="card__topline" style="margin-bottom:1.25rem;">
            <span class="card__kicker">Daily dataset</span>
            <span class="card__index">Updated ${escapeHtml(generated)}</span>
          </div>
          <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2.2rem,4.5vw,4.8rem);line-height:0.92;letter-spacing:-0.055em;margin:0 0 0.4rem;">Current free routes</h2>
          <p class="card__description" style="margin-bottom:1.25rem;">The dataset contains ${allModels.length} free routes. ${scored.length} have an Artificial Analysis intelligence score.</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:0.75rem;margin-bottom:1.25rem;">
            <div class="tracker-stat"><span>Free models</span><strong>${allModels.length}</strong></div>
            <div class="tracker-stat"><span>AA scored</span><strong>${scored.length}</strong></div>
            <div class="tracker-stat"><span>Best score</span><strong>${best?.intelligence ?? '—'}</strong></div>
          </div>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem;">
            <label class="sr-only" for="tracker-search">Filter models</label>
            <input id="tracker-search" type="search" placeholder="Filter models…" autocomplete="off" />
            <button type="button" id="tracker-sort" title="Sort by intelligence score" aria-pressed="false">Score ↓</button>
          </div>
          <div style="overflow-x:auto;">
            <table aria-label="Free OpenRouter models ranked by Artificial Analysis intelligence score" style="width:100%;min-width:720px;border-collapse:collapse;background:var(--panel);border:1px solid var(--line);">
              <thead><tr>
                <th>#</th><th>Model</th><th>Intelligence</th><th>Context</th><th>AA speed</th>
              </tr></thead>
              <tbody data-tracker-body>${table(models)}</tbody>
            </table>
            <p class="muted tracker-scroll-hint" style="margin:0.6rem 0 0;">Swipe the table sideways to see all columns.</p>
            <p class="muted" data-tracker-empty hidden style="padding:1rem 0 0;">No models match “<span data-tracker-query></span>”.</p>
          </div>
          </article>`;

        const search = document.getElementById('tracker-search');
        const sortButton = document.getElementById('tracker-sort');
        const filter = () => {
          const query = search.value.trim().toLowerCase();
          updateTable(models.filter((model) => `${model.name} ${model.provider}`.toLowerCase().includes(query)));
          const queryLabel = document.querySelector('[data-tracker-query]');
          if (queryLabel) queryLabel.textContent = search.value.trim();
        };
        search.addEventListener('input', filter);
        sortButton.addEventListener('click', () => {
          ascending = !ascending;
          models.sort(compareScores);
          sortButton.textContent = ascending ? 'Score ↑' : 'Score ↓';
          sortButton.setAttribute('aria-pressed', String(ascending));
          filter();
        });
      };

      fetch(`/free-llm-tracker/data.json?refresh=${Date.now()}`, { cache: 'no-store' })
        .then((response) => { if (!response.ok) throw new Error('Tracker data unavailable'); return response.json(); })
        .then(render)
        .catch(() => {
          root.innerHTML = '<p class="muted" role="alert">The daily tracker data is temporarily unavailable. The GitHub Action may still be updating it.</p>';
        });
    })();
  </script>

  <style is:global>
    /* is:global: table rows and controls are inserted at runtime via innerHTML,
       so they never receive Astro's scoped-style data attribute. */
    #tracker-root .tracker-stat {
      padding: 0.85rem;
      border: 1px solid var(--line-soft);
      background: color-mix(in srgb, var(--paper) 5%, transparent);
    }
    #tracker-root .tracker-stat span,
    #tracker-root th {
      color: var(--subtle);
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    #tracker-root .tracker-stat strong {
      display: block;
      margin-top: 0.3rem;
      color: var(--text);
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.8rem;
      line-height: 1;
    }
    #tracker-root th {
      padding: 0.7rem 0.85rem;
      border-bottom: 1px solid var(--line);
      text-align: left;
      background: var(--panel-2);
    }
    #tracker-root input,
    #tracker-root button {
      min-height: 2.8rem;
      padding: 0 0.85rem;
      border: 1px solid var(--line);
      border-radius: 0.6rem;
      color: var(--text);
      background: var(--panel);
      font: 0.78rem var(--mono);
    }
    #tracker-root input { min-width: 16rem; }
    #tracker-root button { cursor: pointer; }
    #tracker-root input::placeholder { color: var(--subtle); }
    #tracker-root input:focus-visible,
    #tracker-root button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .tracker-scroll-hint { display: none; }
    @media (max-width: 640px) {
      #tracker-root input { width: 100%; min-width: 0; }
      .tracker-scroll-hint { display: block; }
    }
  </style>
</BaseLayout>
