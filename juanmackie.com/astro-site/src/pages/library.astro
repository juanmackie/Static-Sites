---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { readingList } from '../data/site';

const description = `The reading list: ${readingList.length} books collected by Juan Mackie over time. Reading status is not tracked.`;

---

<BaseLayout title="Reading list | Juan Mackie" description={description} crumbs={[{ name: 'Library' }]}>
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="shell--wide page-block">
    <header class="page-head">
      <p class="eyebrow">Library / Reading list</p>
      <h1>Books I have kept.</h1>
      <p class="page-head__lede">A personal list of books that caught my attention over time. It does not track what I have finished or recommend every title.</p>
    </header>
  </section>

  <section class="library shell--wide" id="reading" aria-labelledby="library-heading">
    <div class="library__topline">
      <div>
        <h2 id="library-heading">The list</h2>
        <p>{readingList.length} titles</p>
      </div>
      <label class="library__search">
        <span>Find a title</span>
        <input id="book-search" type="search" placeholder="Search books" autocomplete="off" aria-controls="book-list" />
      </label>
    </div>
    <p class="library__result" id="book-result" data-total-count={readingList.length} role="status" aria-live="polite">Showing all {readingList.length} titles</p>
    <ul class="library__list" id="book-list">
      {readingList.map((title, index) => (
        <li data-book-title={title.toLocaleLowerCase()}>
          <span aria-hidden="true">{String(index + 1).padStart(3, '0')}</span>
          <span>{title}</span>
        </li>
      ))}
    </ul>
    <p class="library__empty" id="book-empty" hidden>No titles match that search.</p>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#book-search');
  const list = document.querySelector<HTMLElement>('#book-list');
  const result = document.querySelector<HTMLElement>('#book-result');
  const empty = document.querySelector<HTMLElement>('#book-empty');
  const totalCount = Number(result?.dataset.totalCount ?? 0);

  search?.addEventListener('input', () => {
    if (!list || !result || !empty) return;
    const query = search.value.trim().toLocaleLowerCase();
    let visibleCount = 0;

    list.querySelectorAll<HTMLElement>('[data-book-title]').forEach((item) => {
      const matches = item.dataset.bookTitle?.includes(query) ?? false;
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    result.textContent = `Showing ${visibleCount} of ${totalCount} titles`;
    empty.hidden = visibleCount > 0;
  });
</script>
