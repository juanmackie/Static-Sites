---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProofStrip from '../../components/ProofStrip.astro';
import StatusChip from '../../components/StatusChip.astro';
import { caseStudies, groupLabels, groupOrder, projects, sortProjectsByLatestCommit } from '../../data/site';

const description =
  "A public archive of Juan Mackie's released tools and products. Each entry links to a public repository or live product surface.";

const grouped = groupOrder.map((group) => ({
  group,
  label: groupLabels[group],
  items: projects.filter((p) => p.group === group).sort(sortProjectsByLatestCommit)
}));

const caseFiles = caseStudies;
const caseHrefById = new Map(caseStudies.map((study) => [study.id, `/work/${study.slug}`]));
---

<BaseLayout
  title="Work — Juan Mackie"
  description={description}
  crumbs={[{ name: 'Work' }]}
>
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="shell--wide page-block">
    <PageHead
      eyebrow="Work"
      title="A deliberate archive."
      lede="This page contains public repositories and products Juan Mackie has released. A public repository proves existence, not adoption, so the page does not pretend otherwise."
    >
      <div class="button-row">
        <a class="button button--solid" href="/thesis">
          The thesis
          <span class="button__icon" aria-hidden="true">↗</span>
        </a>
        <a class="button" href="/method">
          How I build
          <span class="button__icon" aria-hidden="true">→</span>
        </a>
      </div>
    </PageHead>
  </section>

  <section class="shell--wide bento" id="case-files" aria-labelledby="case-files-heading">
    <div class="section-heading" style="grid-column: 1 / -1;">
      <p class="eyebrow">Case files</p>
      <h2 id="case-files-heading">Work with a write-up.</h2>
    </div>

    <div class="case-index-grid bento__span-12">
      {caseFiles.map((cs) => (
        <a class="case-index-card reveal" href={`/work/${cs.slug}`}>
          <span class="case-index-card__top">
            <span class="case-index-card__kicker">{cs.kicker}</span>
            <StatusChip status={cs.status} />
          </span>
          <strong>{cs.title}</strong>
          <p>{cs.problem}</p>
          <span class="case-index-card__link">READ CASE FILE ↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell--wide bento" id="archive" aria-labelledby="archive-heading">
    <div class="section-heading" style="grid-column: 1 / -1;">
      <p class="eyebrow">Archive</p>
      <h2 id="archive-heading">Everything, grouped.</h2>
    </div>

    {grouped.map((group) => (
      <article class="double-bezel bento__span-12 card reveal" id={group.group}>
        <div class="double-bezel__core">
          <div class="card__topline">
            <span class="card__kicker">{group.label}</span>
            <span class="card__index">{group.items.length.toString().padStart(2, '0')}</span>
          </div>
          <div class="project-grid project-grid--archive">
            {group.items.map((project) => (
              <ProjectCard
                project={project}
                caseHref={caseHrefById.get(project.id)}
                showStage={Boolean(caseHrefById.get(project.id))}
              />
            ))}
          </div>
        </div>
      </article>
    ))}

    <div class="bento__span-12 reveal">
      <ProofStrip />
    </div>
  </section>
</BaseLayout>
