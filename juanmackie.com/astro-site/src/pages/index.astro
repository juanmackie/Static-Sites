---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroWireframe from '../components/HeroWireframe.astro';
import { getCollection } from 'astro:content';
import trackerData from '../../public/free-llm-tracker/data.json';
import { email, projects } from '../data/site';

const description = 'I work in fire protection and build practical software outside it. I write about the tools, systems, and ideas I return to.';
const featuredProjects = projects
  .filter((project) => project.featuredOrder !== undefined)
  .sort((a, b) => a.featuredOrder! - b.featuredOrder!);
const caseHrefById: Record<string, string> = {
  'prompt-paul': '/work/prompt-paul',
  'logseq-housekeeper': '/work/logseq-housekeeper',
  'mnemosyne-hermes': '/work/mnemosyne-hermes'
};
const latestWriting = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
if (!trackerData.generated || !Array.isArray(trackerData.top10)) {
  throw new Error('Free LLM Tracker data is missing its update time or top route list.');
}
const generated = new Intl.DateTimeFormat('en-AU', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'
}).format(new Date(trackerData.generated));

---

<BaseLayout title="Juan Mackie | Operator and software builder" description={description}>
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="home-intro shell--wide" id="about" aria-labelledby="home-heading">
    <div class="home-intro__copy">
      <p class="eyebrow">Operator / Builder / Writer</p>
      <h1 id="home-heading">Juan Mackie.</h1>
      <p class="home-intro__lede">I work in fire protection. Outside it, I build software, explore practical AI, and write about useful systems.</p>
      <p class="home-intro__note">This is a record of what I am making, what I have learned, and what I am still working out.</p>
      <div class="button-row home-intro__actions" id="contact">
        <a class="button button--solid" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={`mailto:${email}`}>Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <HeroWireframe />
    <aside class="home-intro__aside" id="areas" aria-label="A note on the work">
      <p class="home-intro__aside-label">Where I start</p>
      <p>Pay attention to the work. Find the repeated friction. Build something small and see if it helps.</p>
      <a href="/thesis">Read my thesis <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="home-section shell--wide" id="work" aria-labelledby="work-heading">
    <span class="legacy-anchor" id="projects"></span>
    <header class="home-section__header">
      <div>
        <p class="eyebrow">Selected projects</p>
        <h2 id="work-heading">Useful things, made concrete.</h2>
      </div>
      <a class="text-link" href="/work">Browse all {projects.length} projects <span aria-hidden="true">↗</span></a>
    </header>

    <div class="featured-work">
      {featuredProjects.map((project, index) => (
        <article class:list={['featured-project', `featured-project--${project.id}`]} id={project.id} data-project-id={project.id}>
          {index === 0 ? (
            <div class="project-diagram project-diagram--prompt" aria-label="Prompt Paul works with selected text, page context, files, and optional web research">
              <p class="project-diagram__label">A working context, beside the page</p>
              <div class="project-diagram__steps" aria-hidden="true">
                <span>Selected text</span><b>+</b><span>Page or file</span><b>→</b><strong>One place to work</strong>
              </div>
            </div>
          ) : project.id === 'free-llm-tracker' ? (
            <div class="project-diagram project-diagram--tracker" aria-label={`Current tracker data, updated ${generated}`}>
              <div class="project-diagram__heading"><span>Model routes</span><time datetime={trackerData.generated}>{generated}</time></div>
              {trackerData.top10.slice(0, 3).map((route) => (
                <div class="route-preview"><span>{route.name}</span><span>{route.free ? 'Free' : typeof route.task_cost === 'number' ? `$${route.task_cost.toFixed(4)} / task` : 'Price unavailable'}</span></div>
              ))}
              <span class="project-diagram__source">OpenRouter / Vercel AI Gateway</span>
            </div>
          ) : (
            <div class="project-diagram project-diagram--memory" aria-label="Documented agent memory with per-turn and scheduled maintenance loops">
              <span class="memory-loop">Per-turn loop <b>Read and write memory</b></span>
              <span class="memory-loop memory-loop--outer">Scheduled loop <b>Audit, connect, and consolidate</b></span>
              <p>SQLite / Mnemosyne / tools</p>
            </div>
          )}
          <div class="featured-project__body">
            <div class="featured-project__meta"><span>{project.group === 'maintained-fork' ? 'Maintained adaptation' : project.group === 'ai-automation' ? 'AI and automation' : 'Public tool'}</span><span>{project.status}</span></div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="featured-project__links">
              {caseHrefById[project.id] ? <a href={caseHrefById[project.id]}>Read the case file <span aria-hidden="true">↗</span></a> : null}
              {project.id === 'mnemosyne-hermes' ? <a href="/writing/our-agent-memory-stack-how-it-works">Read how the memory stack works <span aria-hidden="true">↗</span></a> : null}
              {project.href ? <a href={project.href} target="_blank" rel="noreferrer">Open project <span aria-hidden="true">↗</span></a> : null}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section home-section--writing shell--wide" id="writings" aria-labelledby="writing-heading">
    <header class="home-section__header">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 id="writing-heading">Notes from the work.</h2>
      </div>
      <a class="text-link" href="/writing">Read the archive <span aria-hidden="true">↗</span></a>
    </header>
    {latestWriting ? (
      <a class="latest-essay" href={`/writing/${latestWriting.id}`}>
        <time datetime={latestWriting.data.date.toISOString()}>{new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(latestWriting.data.date)}</time>
        <h3>{latestWriting.data.title}</h3>
        <p>{latestWriting.data.description ?? 'A note from the archive.'}</p>
        <span>Read essay <span aria-hidden="true">↗</span></span>
      </a>
    ) : <p class="muted">New writing is being prepared for the archive.</p>}
  </section>

  <section class="home-note shell--wide" aria-labelledby="home-note-heading">
    <p class="eyebrow">Away from the workbench</p>
    <h2 id="home-note-heading">Books, records, and ideas worth keeping.</h2>
    <div class="home-note__links">
      <a href="/library" id="reading">Browse the reading list <span aria-hidden="true">↗</span></a>
      <a href="/now#listening" id="listening">See what I am listening to <span aria-hidden="true">↗</span></a>
      <a href="/now#podcast" id="podcast">Listen to One at a Time <span aria-hidden="true">↗</span></a>
      <a href="/links#referrals" id="referrals">Find my other work and referral links <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <span class="legacy-anchor" id="faq"></span>
</BaseLayout>
