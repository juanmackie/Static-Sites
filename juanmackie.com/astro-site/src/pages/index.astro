---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import LastFm from '../components/LastFm.astro';
import HeroWireframe from '../components/HeroWireframe.astro';
import HeroOrb from '../components/HeroOrb.astro';
import {
  email,
  principles,
  referralLinks,
  podcastApps,
  projects,
  readingList,
  socials,
  writings
} from '../data/site';

const description = 'Juan Mackie is a personal site about AI, writing, investing, business, and the projects he is building.';
const featuredProjects = projects.slice(0, 6);
const archivedProjects = projects.slice(6);

const isExternal = (href: string) => /^https?:\/\//.test(href);

const readingListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${Astro.site?.toString().replace(/\/$/, '')}/#reading-list`,
  name: 'Books on Juan Mackie\'s reading list',
  description: 'Current and recent books Juan Mackie is reading or tracking.',
  numberOfItems: readingList.length,
  itemListElement: readingList.slice(0, 20).map((title, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Book',
      name: title
    }
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${Astro.site?.toString().replace(/\/$/, '')}/#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is Juan Mackie?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Juan Mackie is a builder, writer, and observer of systems based in Australia. He focuses on technology, AI, business, investing, software engineering, and the mechanics behind how useful things get made.'
      }
    },
    {
      '@type': 'Question',
      name: 'What topics does Juan Mackie write about?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Juan Mackie writes about AI, business strategy, investing, software engineering, personal operating systems, book notes, and startup culture. His essays are published on Substack and cover corporate fitness, financial systems, technology, and practical thinking frameworks.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is Prompt Paul?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Prompt Paul is a Chrome extension built by Juan Mackie that allows users to process selected text quickly with AI. It is designed for practical use, providing short feedback loops for text processing without ceremony.'
      }
    },
    {
      '@type': 'Question',
      name: 'What is the One at a Time podcast?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'One at a Time is a podcast hosted by Juan Mackie that explores one thought-provoking idea per episode. Topics include technology, business, investing, and whatever else is worth sitting with for a while. Available on Spotify, Apple Podcasts, Overcast, and other platforms.'
      }
    },
    {
      '@type': 'Question',
      name: 'What projects has Juan Mackie built?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Juan Mackie has built projects including Prompt Paul (Chrome extension), UpTick Hours (visualization), ccswap (Claude Code profile manager), Ollama TurboQuant Minimal (local AI), Route-O-Matic (map routing), Marching Waves (generative art), and utilviewer. He also runs the Substack publication where he publishes essays on AI, business, and investing.'
      }
    },
    {
      '@type': 'Question',
      name: 'How can I contact Juan Mackie?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Juan Mackie can be reached by email at juan.mackie@gmail.com. He is also active on Twitter at @juanmackie, on Substack, and on GitHub as juanmackie.'
      }
    }
  ]
};
---

<BaseLayout title="Juan Mackie — Builder, Writer & Systems Thinker" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(readingListSchema)}></script>
  <Fragment slot="nav"><Nav /></Fragment>

  <section class="hero shell--wide" aria-labelledby="home-heading">
    <article class="double-bezel hero__identity reveal">
      <HeroWireframe />
      <div class="hero-ascii-ticker" aria-hidden="true" data-hero-ticker>
        <span>BUILD // SHIP // LISTEN // WRITE // REPEAT // 0101 // E/ACC // NO_WAIT_STATES // LOCAL_SIGNAL // FEEDBACK_LOOP // </span>
        <span>BUILD // SHIP // LISTEN // WRITE // REPEAT // 0101 // E/ACC // NO_WAIT_STATES // LOCAL_SIGNAL // FEEDBACK_LOOP // </span>
      </div>
      <div class="double-bezel__core">
        <div class="display">
          <p class="eyebrow">Personal operating surface</p>
          <h1 id="home-heading">Juan Mackie.</h1>
          <p class="display__lede">A working ledger for technology, AI, entrepreneurship, investing, writing, and the useful things I keep building.</p>
          <p class="display__support">A living index of projects, essays, books, music, and ideas worth returning to.</p>
          <p class="display__support">"AI will do to the human mind, what the bicycle did for human movement."</p>
        </div>

        <div class="button-row">
          <a class="button button--solid" href={`mailto:${email}`}>
            Email Juan
            <span class="button__icon" aria-hidden="true">↗</span>
          </a>
          <a class="button" href="#projects">
            Explore projects
            <span class="button__icon" aria-hidden="true">↓</span>
          </a>
        </div>

        <ul class="hero__meta-row" aria-label="Site highlights">
          {socials.slice(0, 5).map((item) => (
            <li class="hero__meta">
              <span>{item.tag}</span>
              <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </article>

    <aside class="hero__side" aria-label="Current signals">
      <LastFm variant="hero" />

      <section class="double-bezel reveal">
        <div class="double-bezel__core">
          <p class="eyebrow">Acceleration loop</p>
          <p class="muted">Build, ship, listen, write, repeat. The site is a public console for notes, projects, audio, and operating signals.</p>
        </div>
      </section>

      <section class="double-bezel reveal">
        <div class="double-bezel__core">
          <p class="eyebrow">Terminal</p>
          <HeroOrb />
          <pre class="ascii-stack" aria-hidden="true">{`> build --now
> ship --fast
> feedback --live`}</pre>
        </div>
      </section>
    </aside>
  </section>

  <section class="shell--wide bento" id="about" aria-labelledby="about-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">About</p>
      <h2 id="about-heading">Builder, writer, and observer of systems.</h2>
    </div>

    <article class="double-bezel bento__span-7 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Signal</span>
          <span class="card__index">01</span>
        </div>
        <h3>Useful tools, clear thinking, and ideas that survive contact with reality.</h3>
        <p class="card__description">I care about AI, business, investing, and the mechanics behind how useful things get made. Most of the work here sits somewhere between software, media, and personal operating systems.</p>
      </div>
    </article>

    <article class="double-bezel bento__span-5 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Principles</span>
          <span class="card__index">02</span>
        </div>
        <ul class="link-list">
          {principles.map((p) => (
            <li><button type="button" class="principle-trigger" data-principle={p.id}>{p.label}</button></li>
          ))}
        </ul>
      </div>
    </article>
  </section>

  <dialog class="principle-modal" aria-labelledby="principle-heading">
    <div class="principle-modal__panel">
      <button type="button" class="principle-modal__close" aria-label="Close">&times;</button>
      <p class="principle-modal__kicker">Principle</p>
      <h3 id="principle-heading" class="principle-modal__heading"></h3>
      <p class="principle-modal__body"></p>
    </div>
  </dialog>

  <section class="shell--wide bento" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Things by me</p>
      <h2 id="projects-heading">Selected projects and links.</h2>
    </div>

    <article class="double-bezel bento__span-8 card card--large reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Project index</span>
          <span class="card__index">{projects.length.toString().padStart(2, '0')}</span>
        </div>
        <h3>A compact map of writing, experiments, production links, and GitHub work.</h3>
        <div class="project-grid project-grid--featured">
          {featuredProjects.map((project) => (
            project.href ? (
              <a class="project-card" href={project.href} target={isExternal(project.href) ? '_blank' : undefined} rel={isExternal(project.href) ? 'noreferrer' : undefined}>
                <span>{project.category}</span>
                <strong>{project.title}</strong>
                <p>{project.description}</p>
              </a>
            ) : (
              <div class="project-card project-card--plain">
                <span>{project.category}</span>
                <strong>{project.title}</strong>
                <p>{project.description}</p>
              </div>
            )
          ))}
        </div>

        <details class="project-archive">
          <summary>
            <span class="project-archive__label">Archive // {archivedProjects.length} more signals</span>
            <span class="project-archive__action project-archive__action--open">Open archive <b aria-hidden="true">+</b></span>
            <span class="project-archive__action project-archive__action--close">Close archive <b aria-hidden="true">−</b></span>
          </summary>
          <div class="project-grid project-grid--archive">
            {archivedProjects.map((project) => (
              project.href ? (
                <a class="project-card" href={project.href} target={isExternal(project.href) ? '_blank' : undefined} rel={isExternal(project.href) ? 'noreferrer' : undefined}>
                  <span>{project.category}</span>
                  <strong>{project.title}</strong>
                  <p>{project.description}</p>
                </a>
              ) : (
                <div class="project-card project-card--plain">
                  <span>{project.category}</span>
                  <strong>{project.title}</strong>
                  <p>{project.description}</p>
                </div>
              )
            ))}
          </div>
        </details>
      </div>
    </article>

    <article class="double-bezel bento__span-4 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Quick path</span>
          <span class="card__index">03</span>
        </div>
        <h3>Start with the work that is still alive.</h3>
        <p class="card__description">The index includes essays, books, audio, GitHub experiments, and a few production links that shaped the path here.</p>
        <a class="button" href="#writings">
          Read latest
          <span class="button__icon" aria-hidden="true">↓</span>
        </a>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="listening" aria-labelledby="listening-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Listening</p>
      <h2 id="listening-heading">What is playing, and where I keep going.</h2>
    </div>

    <LastFm variant="section" />

    <article class="double-bezel bento__span-7 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Elsewhere</span>
          <span class="card__index">04</span>
        </div>
        <h3>Direct links I actually use.</h3>
        <ul class="link-list">
          <li><a href="https://juanmackie.substack.com" target="_blank" rel="noreferrer">Substack</a></li>
          <li><a href="https://www.goodreads.com/user/show/53993557-juan-mackie" target="_blank" rel="noreferrer">Goodreads</a></li>
          <li><a href="https://www.last.fm/user/juanmackie" target="_blank" rel="noreferrer">Last.fm</a></li>
          <li><a href="https://open.spotify.com/show/3smooBeEnrR7ZV050nEor7" target="_blank" rel="noreferrer">Spotify podcast</a></li>
        </ul>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="writings" aria-labelledby="writings-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Writings</p>
      <h2 id="writings-heading">Recent essays.</h2>
    </div>

    <article class="double-bezel bento__span-12 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Archive</span>
          <span class="card__index">{writings.length.toString().padStart(2, '0')}</span>
        </div>
        <h3>Notes on AI, business, money, tools, and the systems around them.</h3>
        <ol class="numbered-list">
          {writings.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a>
            </li>
          ))}
        </ol>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="reading" aria-labelledby="reading-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Reading</p>
      <h2 id="reading-heading">Books on the desk.</h2>
    </div>

    <article class="double-bezel bento__span-12 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Reading list</span>
          <span class="card__index">{readingList.length.toString().padStart(2, '0')}</span>
        </div>
        <ul class="reading-grid">
          {readingList.map((title) => <li>{title}</li>)}
        </ul>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="podcast" aria-labelledby="podcast-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Podcast</p>
      <h2 id="podcast-heading">One thought at a time.</h2>
    </div>

    <article class="double-bezel bento__span-7 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Audio</span>
          <span class="card__index">05</span>
        </div>
        <h3>A place for technology, business, investing, and whatever is worth sitting with.</h3>
        <p class="card__description">The podcast where I explore one thought-provoking idea at a time. It is a place for technology, business, investing, and whatever else is worth sitting with for a while.</p>
        <div class="podcast-embed">
          <iframe src="https://podcasters.spotify.com/pod/show/juan-mackie/embed" height="102" title="One at a time podcast embed" loading="lazy"></iframe>
        </div>
      </div>
    </article>

    <article class="double-bezel bento__span-5 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Listen on</span>
          <span class="card__index">06</span>
        </div>
        <ul class="link-list">
          {podcastApps.map((app) => (
            <li><a href={app.href} target="_blank" rel="noreferrer">{app.label}</a></li>
          ))}
        </ul>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="prompt-paul" aria-labelledby="prompt-paul-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Prompt Paul</p>
      <h2 id="prompt-paul-heading">AI-powered text assistant.</h2>
    </div>

    <article class="double-bezel bento__span-7 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Chrome extension</span>
          <span class="card__index">07</span>
        </div>
        <h3>Short feedback loops for selected text, without ceremony.</h3>
        <p class="card__description">Prompt Paul is a Chrome extension that helps process selected text quickly with AI. It is built for practical use, not ritual.</p>
        <div class="button-row">
          <a class="button button--solid" href="https://www.promptpaul.juanmackie.com/" target="_blank" rel="noreferrer">
            Open Prompt Paul
            <span class="button__icon" aria-hidden="true">↗</span>
          </a>
          <a class="button" href="/privacy">Privacy policy</a>
        </div>
      </div>
    </article>

    <article class="double-bezel bento__span-5 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Support</span>
          <span class="card__index">08</span>
        </div>
        <p class="card__description">If you want to support the project, use the Ko-fi link in the site footer or send a direct note.</p>
        <a class="button" href={`mailto:${email}`}>
          Email Juan
          <span class="button__icon" aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="referrals" aria-labelledby="referrals-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Referral links</p>
      <h2 id="referrals-heading">Referral Links and Codes.</h2>
    </div>

    <article class="double-bezel bento__span-12 card reveal">
      <div class="double-bezel__core">
        <div class="card__topline">
          <span class="card__kicker">Codes</span>
          <span class="card__index">09</span>
        </div>
        <h3>Services I use that still have referral codes attached.</h3>
        <ul class="link-list">
          {referralLinks.map((item) => (
            <li><a href={item.href} target="_blank" rel="noreferrer">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </article>
  </section>

  <section class="shell--wide bento" id="contact" aria-labelledby="contact-heading">
    <div class="section-heading reveal" style="grid-column: 1 / -1;">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-heading">Reach out by email.</h2>
    </div>

    <article class="double-bezel bento__span-12 card reveal">
      <div class="double-bezel__core contact-panel">
        <div>
          <h3>No form. Send a direct message.</h3>
          <p class="card__description">Use email for collaborations, questions, project notes, or anything that should not get lost in a feed.</p>
        </div>
        <a class="button button--solid" href={`mailto:${email}`}>
          {email}
          <span class="button__icon" aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  </section>

  <footer slot="footer" class="footer">
    <div class="shell--wide">
      <div class="double-bezel reveal">
        <div class="double-bezel__core footer__inner">
          <p>Juan Mackie</p>
          <p class="muted">1989-</p>
          <a class="text-link" href="https://ko-fi.com/N4N3184MUV" target="_blank" rel="noreferrer">Ko-fi</a>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>

<script>
  import { principles } from '../data/site';

  const dialog = document.querySelector('.principle-modal');
  const heading = dialog?.querySelector('#principle-heading');
  const body = dialog?.querySelector('.principle-modal__body');
  const closeBtn = dialog?.querySelector('.principle-modal__close');
  let lastTrigger = null;

  document.querySelectorAll('.principle-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.principle;
      const principle = principles.find((p) => p.id === id);
      if (!principle || !dialog || !heading || !body) return;
      heading.textContent = principle.label;
      body.textContent = principle.text;
      lastTrigger = btn;
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  dialog?.addEventListener('close', () => {
    lastTrigger?.focus();
  });
</script>
