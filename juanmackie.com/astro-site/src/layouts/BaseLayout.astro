---
import '../styles/global.css';
import '../styles/refinement.css';
import Analytics from '../components/Analytics.astro';
import ChatWidget from '../components/ChatWidget.astro';
import Footer from '../components/Footer.astro';

type Crumb = { name: string; href?: string };

type Props = {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  article?: { publishedTime: string; modifiedTime: string };
  /** Breadcrumb trail after Home; renders BreadcrumbList schema. */
  crumbs?: Crumb[];
};

const {
  title = 'Juan Mackie',
  description = 'Juan Mackie: technology, AI, writing, projects, and podcasts.',
  ogType = 'website',
  article,
  crumbs = []
} = Astro.props as Props;

const compactTitle = title.replace(/\s+—\s+Juan Mackie$/, '').trim();
const shortTitleMap: Record<string, string> = {
  'About — Juan Mackie': 'About Juan Mackie — Builder and Writer',
  'Work — Juan Mackie': 'Work and Projects — Juan Mackie',
  'Writing — Juan Mackie': 'Writing by Juan Mackie — Essays and Ideas',
  'Privacy — Juan Mackie': 'Privacy Policy — Juan Mackie'
};
const titleCandidate = compactTitle.split(/\s+—\s+|:\s+/)[0].trim();
const seoTitle = shortTitleMap[title] ?? (
  title.length <= 60
    ? title
    : titleCandidate.toLowerCase() !== 'juan mackie' && `${titleCandidate} — Juan Mackie`.length <= 60
      ? `${titleCandidate} — Juan Mackie`
      : `${compactTitle.slice(0, 57).trimEnd()}…`
);
const metaDescription = description.length > 160
  ? `${description.slice(0, 157).replace(/\s+\S*$/, '').trimEnd()}…`
  : description;

const siteUrl = (Astro.site?.toString() ?? 'https://juanmackie.com').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const isHome = canonical === siteUrl || canonical === `${siteUrl}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical.replace(/\/$/, '')}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    ...crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: crumb.name,
      ...(crumb.href ? { item: new URL(crumb.href, siteUrl).toString() } : {})
    }))
  ]
};

const sameAs = [
  'https://twitter.com/juanmackie',
  'https://juanmackie.substack.com',
  'https://www.goodreads.com/user/show/53993557-juan-mackie',
  'https://github.com/juanmackie',
  'https://medium.com/@juan.mackie',
  'https://www.last.fm/user/juanmackie'
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: seoTitle,
  description: metaDescription,
  isPartOf: {
    '@id': `${siteUrl}/#website`
  },
  about: {
    '@id': `${siteUrl}/#person`
  }
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Juan Mackie',
  description: 'A personal site about fire protection, field operations, practical AI, automation, writing, and the systems Juan Mackie is building.',
  publisher: {
    '@id': `${siteUrl}/#person`
  }
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: 'Juan Mackie',
  url: siteUrl,
  sameAs,
  description: 'Operator, builder, writer, and systems thinker working at the intersection of fire protection, field operations, practical AI, and business design.',
  knowsAbout: ['Fire Protection', 'Field Service Operations', 'Artificial Intelligence', 'Automation', 'Business Systems', 'Investing', 'Software Engineering', 'Writing']
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#030303" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {article ? <meta property="article:published_time" content={article.publishedTime} /> : null}
    {article ? <meta property="article:modified_time" content={article.modifiedTime} /> : null}
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const storedTheme = window.localStorage.getItem('juanmackie-theme');
          const theme = storedTheme === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#030303' : '#e5dcc9');
        } catch {
          document.documentElement.dataset.theme = 'dark';
          document.documentElement.style.colorScheme = 'dark';
        }
      })();
    </script>
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
      </style>
    </noscript>
    <title>{seoTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot name="nav" />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <ChatWidget />
  </body>
</html>

<script>
  const revealItems = Array.from(document.querySelectorAll('.reveal'));

  revealItems.forEach((item) => {
    const section = item.closest('section');
    const siblings = section ? Array.from(section.querySelectorAll('.reveal')) : revealItems;
    const delay = Math.min(siblings.indexOf(item) * 55, 220);
    item.style.setProperty('--reveal-delay', `${delay}ms`);
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, {
      // A fixed ratio threshold breaks very tall cards (e.g. the 250-item
      // reading list, which is ~15,000px tall on a single-column mobile
      // layout): 12% of that never fits in the viewport, so the reveal
      // never fires and the content stays invisible. 1% is enough to
      // trigger while the element is still entering the screen.
      threshold: 0.01,
      rootMargin: '0px 0px -8% 0px'
    });

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }
</script>
