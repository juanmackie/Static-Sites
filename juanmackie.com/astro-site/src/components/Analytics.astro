---
const configuredGaId = import.meta.env.PUBLIC_GA_ID?.trim();
const gaId = configuredGaId && /^G-[A-Z0-9]+$/i.test(configuredGaId) ? configuredGaId : null;
const configuredUmamiSrc = import.meta.env.PUBLIC_UMAMI_SRC?.trim();
const umamiSrc = (() => {
  if (!configuredUmamiSrc) return null;

  try {
    const parsed = new URL(configuredUmamiSrc);
    return parsed.protocol === 'https:' ? parsed.toString() : null;
  } catch {
    return null;
  }
})();
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
---

{gaId ? (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
) : null}

{umamiSrc && umamiWebsiteId ? <script defer src={umamiSrc} data-website-id={umamiWebsiteId}></script> : null}
