---
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-76Y4PMQ670';
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

{gaId ? (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
) : null}

{umamiSrc && umamiWebsiteId ? <script defer src={umamiSrc} data-website-id={umamiWebsiteId}></script> : null}
