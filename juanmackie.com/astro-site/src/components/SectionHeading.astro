---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  /** Tier 2 = secondary personal surfaces (listening, reading…). */
  tier?: 1 | 2;
}

const { eyebrow, title, id, tier = 1 } = Astro.props;
---

<div class:list={['section-heading', tier === 2 ? 'section-heading--tier-2' : '']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  <slot />
</div>
