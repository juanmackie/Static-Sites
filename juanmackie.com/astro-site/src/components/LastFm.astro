---
import { lastFm } from '../data/site';

type Props = {
  variant?: 'hero' | 'section';
};

const { variant = 'section' } = Astro.props as Props;
const username = import.meta.env.PUBLIC_LASTFM_USERNAME ?? lastFm.username;
const apiKey = import.meta.env.PUBLIC_LASTFM_API_KEY ?? lastFm.apiKey;
const profileUrl = import.meta.env.PUBLIC_LASTFM_PROFILE_URL ?? lastFm.profileUrl;
const isHero = variant === 'hero';
const headingId = `lastfm-heading-${variant}`;
const statusLabelId = `np-status-label-${variant}`;
const statusTextId = `np-status-text-${variant}`;
const trackListId = `track-list-${variant}`;
const trackCountId = `track-count-${variant}`;
---

<section class:list={['double-bezel', 'card', 'listening-widget', `listening-widget--${variant}`, isHero ? 'hero__now-playing' : 'bento__span-5', 'reveal']} aria-labelledby={headingId}>
  <div class="double-bezel__core">
    <div class="section-heading">
      <p class="eyebrow">{isHero ? 'Now playing / Last.fm' : 'Last.fm'}</p>
      <h2 id={headingId}>{isHero ? 'Live signal.' : 'What I am listening to'}</h2>
      <a class="text-link" href={profileUrl} target="_blank" rel="noreferrer">FULL HISTORY</a>
    </div>

    <pre class="listening-widget__ascii" aria-hidden="true">{`╔════════════════════════════╗
║  AUDIO BUS  //  44.1 KHZ   ║
╚═══ ▓▒░  ░▒▓  ▓▒░  ░▒▓ ═══╝`}</pre>

    <div class="listening-widget__status">
      <span id={statusLabelId}>Offline</span>
      <strong id={statusTextId}>Currently offline</strong>
    </div>

    <ul class="listening-widget__tracks" id={trackListId}></ul>
    <p class="muted" id={trackCountId}>0 tracks</p>
  </div>
</section>

<script define:vars={{ username, apiKey, statusLabelId, statusTextId, trackListId, trackCountId }}>
  const list = document.getElementById(trackListId);
  const statusLabel = document.getElementById(statusLabelId);
  const statusText = document.getElementById(statusTextId);
  const trackCount = document.getElementById(trackCountId);

  const POLL_MS = 60_000;
  let intervalId = null;
  let lastSignature = '';

  if (list && statusLabel && statusText && trackCount) {
    const endpoint = new URL('https://ws.audioscrobbler.com/2.0/');
    endpoint.searchParams.set('method', 'user.getrecenttracks');
    endpoint.searchParams.set('user', username);
    endpoint.searchParams.set('api_key', apiKey);
    endpoint.searchParams.set('format', 'json');
    endpoint.searchParams.set('limit', '10');

    const createTrack = (number, name, artist) => {
      const item = document.createElement('li');
      const index = document.createElement('span');
      const title = document.createElement('strong');
      const performer = document.createElement('em');

      item.className = 'listening-widget__track';
      index.textContent = String(number).padStart(2, '0');
      title.textContent = name || 'Unknown track';
      performer.textContent = artist || 'Unknown artist';

      item.append(index, title, performer);
      return item;
    };

    function render(data) {
      const tracks = data?.recenttracks?.track || [];
      const primaryTrack = tracks[0];
      let count = 0;

      const artist = primaryTrack?.artist?.['#text'] || 'Unknown artist';
      const name = primaryTrack?.name || 'Unknown track';
      const isNowPlaying = primaryTrack?.['@attr']?.nowplaying === 'true';
      const signature = `${isNowPlaying ? 'np' : 'lp'}|${artist}|${name}|${tracks.length}`;

      if (signature === lastSignature) return;
      lastSignature = signature;

      list.replaceChildren();

      if (primaryTrack) {
        statusLabel.textContent = isNowPlaying ? 'Now playing' : 'Last played';
        statusText.textContent = `${artist} - ${name}`;
      }

      tracks.forEach((track, index) => {
        const trackNowPlaying = track?.['@attr']?.nowplaying === 'true';
        const trackArtist = track?.artist?.['#text'] || 'Unknown artist';
        const trackName = track?.name || 'Unknown track';

        if (index === 0 || trackNowPlaying) return;

        if (count >= 6) return;
        count += 1;
        list.appendChild(createTrack(count, trackName, trackArtist));
      });

      trackCount.textContent = `${count} recent tracks`;
    }

    function poll() {
      fetch(endpoint)
        .then((response) => response.json())
        .then(render)
        .catch(() => {
          statusLabel.textContent = 'Offline';
          statusText.textContent = 'Unable to connect to stream.';
          trackCount.textContent = '0 tracks';
        });
    }

    poll();
    intervalId = setInterval(poll, POLL_MS);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearInterval(intervalId);
        intervalId = null;
      } else {
        poll();
        intervalId = setInterval(poll, POLL_MS);
      }
    });
  }
</script>
