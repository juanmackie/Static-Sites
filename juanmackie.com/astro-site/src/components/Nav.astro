---
import { email } from '../data/site';

const items = [
  ['Work', '/work'],
  ['Writing', '/writing'],
  ['Thesis', '/thesis'],
  ['About', '/about'],
  ['Contact', '/#contact']
];
---

<header class="site-nav" data-site-nav>
  <div class="site-nav__island">
    <a class="site-nav__brand" href="/" aria-label="JM — Juan Mackie home">JM</a>

    <nav class="site-nav__links" aria-label="Primary">
      {items.map(([label, href]) => (
        <a href={href}>{label}</a>
      ))}
    </nav>

    <a class="site-nav__email" href={`mailto:${email}`}>Email Juan</a>

    <button
      class="site-nav__theme-toggle"
      type="button"
      aria-label="Dark theme — switch to light theme"
      aria-pressed="true"
      data-theme-toggle
    >
      <span data-theme-label>Dark</span>
    </button>

    <button
      class="site-nav__menu-button"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-overlay"
      data-nav-toggle
    >
      <span class="site-nav__menu-lines" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="site-nav__overlay" id="nav-overlay" aria-hidden="true">
    <nav class="site-nav__overlay-links" aria-label="Mobile navigation">
      {items.map(([label, href]) => (
        <a href={href} tabindex="-1">{label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-site-nav]');

  if (nav) {
    const toggle = nav.querySelector('[data-nav-toggle]');
    const overlay = nav.querySelector('[id="nav-overlay"]');
    const overlayLinks = overlay?.querySelectorAll('a');
    const themeToggle = nav.querySelector('[data-theme-toggle]');
    const themeLabel = nav.querySelector('[data-theme-label]');

    const setTheme = (theme) => {
      const normalizedTheme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.dataset.theme = normalizedTheme;
      document.documentElement.style.colorScheme = normalizedTheme;
      themeToggle?.setAttribute('aria-pressed', String(normalizedTheme === 'dark'));
      themeToggle?.setAttribute('aria-label', normalizedTheme === 'dark' ? 'Dark theme — switch to light theme' : 'Light theme — switch to dark theme');
      if (themeLabel) themeLabel.textContent = normalizedTheme === 'dark' ? 'Dark' : 'Light';

      const metaTheme = document.querySelector('meta[name="theme-color"]');
      metaTheme?.setAttribute('content', normalizedTheme === 'dark' ? '#030303' : '#e5dcc9');

      try {
        window.localStorage.setItem('juanmackie-theme', normalizedTheme);
      } catch {
        // Theme persistence is progressive enhancement.
      }
    };

    setTheme(document.documentElement.dataset.theme);

    const setOpen = (open) => {
      if (!toggle || !overlay) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      overlay.classList.toggle('is-open', open);
      overlay.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('nav-open', open);

      overlayLinks?.forEach((link) => {
        link.setAttribute('tabindex', open ? '0' : '-1');
      });

      if (open) {
        window.setTimeout(() => overlayLinks?.[0]?.focus(), 120);
      } else {
        toggle?.focus();
      }
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    themeToggle?.addEventListener('click', () => {
      const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      setTheme(nextTheme);
    });

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) setOpen(false);
    });

    overlayLinks?.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
