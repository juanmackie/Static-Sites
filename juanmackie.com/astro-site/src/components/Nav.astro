---
import { email } from '../data/site';

const items = [
  ['Work', '/work'],
  ['Writing', '/writing'],
  ['About', '/about'],
  ['Now', '/now']
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-nav" data-site-nav>
  <div class="site-nav__island">
    <a class="site-nav__brand" href="/" aria-label="JM — Juan Mackie home">JM</a>

    <nav class="site-nav__links" aria-label="Primary">
      {items.map(([label, href]) => (
        <a
          class:list={{ 'is-active': isActive(href) }}
          aria-current={isActive(href) ? 'page' : undefined}
          href={href}
        >{label}</a>
      ))}
    </nav>

    <a class="site-nav__email" href={`mailto:${email}`}>Email</a>

    <button
      class="site-nav__theme-toggle"
      type="button"
      aria-label="Dark theme — switch to light theme"
      aria-pressed="true"
      data-theme-toggle
    >
      <span data-theme-label>Dark</span>
    </button>

    <details class="site-nav__mobile">
      <summary aria-label="Toggle navigation menu"><span aria-hidden="true">Menu</span></summary>
      <nav class="site-nav__mobile-links" aria-label="Mobile navigation">
        {items.map(([label, href]) => (
          <a
            class:list={{ 'is-active': isActive(href) }}
            aria-current={isActive(href) ? 'page' : undefined}
            href={href}
          >{label}</a>
        ))}
        <a href="/library">Library</a>
        <a href="/links">Links</a>
        <a href={`mailto:${email}`}>Email</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-site-nav]');

  if (nav) {
    const themeToggle = nav.querySelector('[data-theme-toggle]');
    const themeLabel = nav.querySelector('[data-theme-label]');

    const setTheme = (theme) => {
      const normalizedTheme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.dataset.theme = normalizedTheme;
      document.documentElement.style.colorScheme = normalizedTheme;
      themeToggle?.setAttribute('aria-pressed', String(normalizedTheme === 'dark'));
      themeToggle?.setAttribute('aria-label', normalizedTheme === 'dark' ? 'Dark theme — switch to light theme' : 'Light theme — switch to dark theme');
      if (themeLabel) themeLabel.textContent = normalizedTheme === 'dark' ? 'Dark' : 'Light';

      const metaTheme = document.querySelector('meta[name="theme-color"]');
      metaTheme?.setAttribute('content', normalizedTheme === 'dark' ? '#030303' : '#e5dcc9');

      try {
        window.localStorage.setItem('juanmackie-theme', normalizedTheme);
      } catch {
        // Theme persistence is progressive enhancement.
      }
    };

    setTheme(document.documentElement.dataset.theme);

    themeToggle?.addEventListener('click', () => {
      const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      setTheme(nextTheme);
    });

  }
</script>
