---
import { getCollection } from 'astro:content';
import { projects } from '../data/site';

const writings = await getCollection('writing', ({ data }) => !data.draft);

// Only counts that are verifiable from this site or its public surfaces.
const points = [
  { label: 'Public projects', value: String(projects.length).padStart(2, '0'), note: 'repos and products' },
  { label: 'Essays', value: String(writings.length).padStart(2, '0'), note: 'on this site' },
  { label: 'Launched products', value: String(projects.filter((project) => project.status === 'Live').length).padStart(2, '0'), note: 'publicly live' },
  { label: 'Fabricated metrics', value: '00', note: 'by design' }
];
---

<div class="proof-strip" aria-label="Verifiable counts">
  {points.map((point) => (
    <div class="proof-strip__item">
      <strong class="proof-strip__value">{point.value}</strong>
      <span class="proof-strip__label">{point.label}</span>
      <span class="proof-strip__note">{point.note}</span>
    </div>
  ))}
</div>
