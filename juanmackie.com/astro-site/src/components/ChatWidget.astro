---
import { email } from '../data/site';

const configuredWebhookUrl = import.meta.env.PUBLIC_CHAT_WEBHOOK_URL?.trim();
const webhookUrl = (() => {
  if (!configuredWebhookUrl) return null;

  try {
    const parsed = new URL(configuredWebhookUrl);
    return parsed.protocol === 'https:' ? parsed.toString() : null;
  } catch {
    return null;
  }
})();
const route = import.meta.env.PUBLIC_CHAT_ROUTE?.trim() || 'general';
const maxMessageLength = 1000;
const maxResponseLength = 4000;
---

<div class="chat-widget" data-chat-widget>
  <button class="chat-widget__toggle" type="button" aria-expanded="false" aria-controls="chat-panel" data-chat-toggle>
    <span class="chat-widget__toggle-dot" aria-hidden="true"></span>
    Chat
  </button>

  <section class="chat-widget__panel" id="chat-panel" aria-label="Chat widget" hidden data-chat-panel>
    <div class="chat-widget__panel-inner">
      <header class="chat-widget__header">
        <div>
          <p class="eyebrow">Chat widget</p>
          <h2>Ask a question</h2>
        </div>
        <button class="chat-widget__close" type="button" aria-label="Close chat" data-chat-close>Close</button>
      </header>

      {webhookUrl ? (
        <>
          <div class="chat-widget__body" data-chat-messages aria-live="polite"></div>

          <form class="chat-widget__form" data-chat-form>
            <label class="sr-only" for="chat-input">Message</label>
            <input id="chat-input" name="message" type="text" placeholder="Send a message" autocomplete="off" maxlength={maxMessageLength} required data-chat-input />
            <button type="submit">Send</button>
          </form>
        </>
      ) : (
        <div class="chat-widget__fallback">
          <p class="chat-widget__fallback-title">Live chat is offline on this build.</p>
          <p class="muted">Use email instead. It goes straight to Juan.</p>
          <a class="button button--solid" href={`mailto:${email}`}>
            Email Juan
            <span class="button__icon" aria-hidden="true">↗</span>
          </a>
        </div>
      )}
    </div>
  </section>
</div>

<script define:vars={{ webhookUrl, route, maxMessageLength, maxResponseLength }}>
  const widget = document.querySelector('[data-chat-widget]');
  if (widget) {
    const toggle = widget.querySelector('[data-chat-toggle]');
    const close = widget.querySelector('[data-chat-close]');
    const panel = widget.querySelector('[data-chat-panel]');
    const form = widget.querySelector('[data-chat-form]');
    const input = widget.querySelector('[data-chat-input]');
    const messages = widget.querySelector('[data-chat-messages]');
    const sendButton = form?.querySelector('button');

    if (toggle && close && panel) {
      const chatIdKey = 'juanmackie-chat-id';

      const getChatId = () => {
        try {
          const existing = sessionStorage.getItem(chatIdKey);
          if (existing) return existing;

          const created = `chat_${crypto.randomUUID()}`;
          sessionStorage.setItem(chatIdKey, created);
          return created;
        } catch {
          return `chat_${Math.random().toString(36).slice(2, 11)}`;
        }
      };

      const addMessage = (text, kind) => {
        if (!messages) return;
        const bubble = document.createElement('p');
        bubble.className = `chat-widget__message chat-widget__message--${kind}`;
        bubble.textContent = text;
        messages.appendChild(bubble);
        messages.scrollTop = messages.scrollHeight;
      };

      const openWidget = () => {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => widget.classList.add('is-open'));
        input?.focus();
        if (messages && !messages.hasChildNodes()) {
          addMessage('Hi. Ask about the site, the projects, or the best way to reach me.', 'bot');
        }
      };

      const closeWidget = () => {
        widget.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        window.setTimeout(() => {
          if (!widget.classList.contains('is-open')) panel.hidden = true;
        }, 260);
        toggle.focus();
      };

      const addTypingIndicator = () => {
        if (!messages) return;
        const typing = document.createElement('p');
        typing.className = 'chat-widget__message chat-widget__message--bot chat-widget__message--typing';
        typing.setAttribute('aria-hidden', 'true');
        for (let index = 0; index < 3; index += 1) {
          typing.appendChild(document.createElement('span'));
        }
        messages.appendChild(typing);
        messages.scrollTop = messages.scrollHeight;
      };

      const removeTypingIndicator = () => {
        messages?.querySelector('.chat-widget__message--typing')?.remove();
      };

      const setPending = (pending) => {
        if (input) input.disabled = pending;
        if (sendButton) sendButton.disabled = pending;
      };

      toggle.addEventListener('click', () => {
        if (panel.hidden) openWidget(); else closeWidget();
      });

      close.addEventListener('click', closeWidget);

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          event.preventDefault();
          closeWidget();
        }
      });

      if (webhookUrl && form && input && messages) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const message = input.value.trim();
          if (!message || input.disabled) return;
          if (message.length > maxMessageLength) {
            addMessage(`Messages are limited to ${maxMessageLength} characters.`, 'bot');
            return;
          }

          addMessage(message, 'user');
          input.value = '';
          setPending(true);
          addTypingIndicator();
          input.focus();

          try {
            const response = await fetch(webhookUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ chatId: getChatId(), message, route })
            });

            if (!response.ok) throw new Error(`Chat request failed with status ${response.status}`);

            const responseText = (await response.text()).trim();
            let output = responseText;

            try {
              const data = JSON.parse(responseText);
              output = typeof data === 'string' ? data : typeof data?.output === 'string' ? data.output : '';
            } catch {
              // n8n may return the assistant reply as plain text.
            }

            removeTypingIndicator();
            addMessage(output.slice(0, maxResponseLength) || 'I could not parse that response.', 'bot');
          } catch {
            removeTypingIndicator();
            addMessage('Connection failed. Please try again.', 'bot');
          } finally {
            setPending(false);
            input.focus();
          }
        });
      }
    }
  }
</script>
